# Copy to .env.local for local dev. On Vercel, set these in Project → Settings → Environment Variables.

# ─── Real wallet payments (Base Sepolia testnet) ───────────────────────────
# The address that receives test USDC. Leave empty to keep checkout on the
# simulated wallet only. Use a testnet-only address, never one holding real funds.
MERCHANT_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: your own Base Sepolia RPC (Alchemy, Infura…). Defaults to the public
# https://sepolia.base.org, which is rate-limited.
BASE_SEPOLIA_RPC_URL=

# ─── Shared storage (Upstash Redis) ────────────────────────────────────────
# Idempotency keys, quote locks, used tx hashes and INP samples. Without these
# the app falls back to in-memory storage (fine locally, not across serverless
# instances). Adding Upstash from the Vercel Marketplace sets KV_REST_API_URL /
# KV_REST_API_TOKEN automatically; either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
